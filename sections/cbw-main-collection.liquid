{%- liquid
  assign page_size = template.suffix | plus: 0
  if page_size < 1 or page_size > 250
    assign page_size = section.settings.products_per_page
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="cbw-container">
  <div class="cbw-layout cbw-layout--sidebar">
    {%- render 'cbw-sidebar' -%}
    <div class="cbw-listing">
      {%- render 'cbw-breadcrumb', current: collection.title -%}
      <h1 class="cbw-listing__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="cbw-listing__description">{{ collection.description }}</div>
      {%- endif -%}

      {%- paginate collection.products by page_size -%}
        {%- if collection.products_count > 0 -%}
          {%- render 'cbw-listing-toolbar',
            paginate: paginate,
            action: collection.url,
            sort_by: sort_by,
            sort_values: 'price-ascending,price-descending,best-selling,title-ascending,created-descending,created-ascending',
            page_size: page_size
          -%}
          {%- render 'cbw-listing-grid', items: collection.products, show_availability: true -%}
          {%- render 'cbw-listing-toolbar',
            paginate: paginate,
            action: collection.url,
            sort_by: sort_by,
            sort_values: '',
            page_size: page_size,
            position: 'bottom'
          -%}
        {%- else -%}
          <p class="cbw-listing__empty">{{ 'cbw.listing.empty_collection' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:cbw.collection.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:cbw.collection.products_per_page",
      "min": 8,
      "max": 64,
      "step": 4,
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:cbw.collection.show_description",
      "default": true
    }
  ]
}
{% endschema %}

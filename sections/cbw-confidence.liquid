<div class="cbw-confidence">
  <div class="cbw-container cbw-confidence__grid">
    <div class="cbw-confidence__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cbw-confidence__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="cbw-confidence__text">{{ section.settings.text }}</div>
      <div class="cbw-confidence__buttons">
        {%- if section.settings.button_1_label != blank -%}
          <a class="cbw-btn cbw-confidence__button" href="{{ section.settings.button_1_link | default: '#' }}">
            {{- section.settings.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="cbw-btn cbw-confidence__button" href="{{ section.settings.button_2_link | default: '#' }}">
            {{- section.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="cbw-confidence__list" role="list">
        {%- for block in section.blocks -%}
          <li class="cbw-confidence__item" {{ block.shopify_attributes }}>
            {%- render 'cbw-icon', name: block.settings.icon, class: 'cbw-confidence__icon' -%}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cbw-confidence {
    padding-top: 39px;
    background-color: #e7e6fe;
  }
  .cbw .cbw-confidence__heading {
    margin: 0 0 11px;
    color: var(--cbw-navy);
    font-size: 39px;
    line-height: 1.1;
  }
  .cbw-confidence__text p {
    margin: 0 0 10px;
    line-height: 1.63;
  }
  .cbw-confidence__text p:last-child {
    margin-bottom: 2em;
  }
  .cbw .cbw-confidence__button {
    display: block;
    width: 100%;
    margin-bottom: 23px;
    font-size: 18px;
    line-height: 63px;
    text-align: center;
  }
  .cbw-confidence__list {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--cbw-navy);
    font-size: 20px;
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
  }
  .cbw-confidence__item {
    padding: 26px 0;
    border-top: 1px solid #ebebeb;
  }
  .cbw-confidence__item:first-child {
    border-top: 0;
  }
  .cbw-confidence__icon {
    display: block;
    width: 57px;
    height: 39px;
    margin: auto;
    fill: currentColor;
  }

  @media (min-width: 768px) {
    .cbw .cbw-confidence__button {
      display: inline-block;
      width: auto;
      margin-right: 25px;
      font-size: 16px;
      line-height: 52px;
    }
  }
  @media (min-width: 768px) and (max-width: 991px) {
    .cbw-confidence__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .cbw-confidence__item:nth-child(2) {
      border-top: 0;
    }
    .cbw-confidence__item:nth-child(odd) {
      border-right: 1px solid #ebebeb;
    }
  }
  @media (min-width: 992px) {
    .cbw-confidence {
      padding: 47px 0 16px;
    }
    .cbw-confidence__grid {
      display: grid;
      grid-template-columns: 3fr 6fr 3fr;
      margin-inline: auto;
      padding: 0;
    }
    .cbw-confidence__grid > * {
      padding-inline: 15px;
    }
    .cbw-confidence__content {
      grid-column: 2;
    }
    .cbw-confidence__list {
      font-size: 18px;
      text-align: left;
    }
    .cbw-confidence__item {
      display: flex;
      align-items: center;
      gap: 3px;
      border-top: 0;
    }
    .cbw-confidence__icon {
      flex: 0 0 57px;
      margin: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.confidence.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:cbw.confidence.heading",
      "default": "Shop with Confidence"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:cbw.confidence.text",
      "default": "<p>Circuit Breaker Warehouse's capabilities range from single retail store installations to multi-outlet chains and major high-rise development. The continued commitment customer service, high quality products, and competitive price have advanced Circuit Breaker Warehouse to be Southern California's most complete Circuit Breaker source.</p><p>In our vision to the future, Circuit Breaker Warehouse will continue to be an effective distributor of products &amp; services for customers, providing value beyond their expectations.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "t:cbw.confidence.button_1_label",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "t:cbw.confidence.button_1_link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:cbw.confidence.button_2_label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "t:cbw.confidence.button_2_link"
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "t:cbw.confidence.guarantee",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:cbw.confidence.icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "t:cbw.confidence.icon_shield" },
            { "value": "check-mark", "label": "t:cbw.confidence.icon_check" },
            { "value": "money", "label": "t:cbw.confidence.icon_money" },
            { "value": "award", "label": "t:cbw.confidence.icon_award" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:cbw.confidence.guarantee_text",
          "default": "ID theft protection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:cbw.confidence.name",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "shield", "text": "ID theft protection" } },
        { "type": "guarantee", "settings": { "icon": "check-mark", "text": "Purchase guarantee" } },
        { "type": "guarantee", "settings": { "icon": "money", "text": "Lowest price guarantee" } },
        { "type": "guarantee", "settings": { "icon": "award", "text": "100% satisfaction guarantee" } }
      ]
    }
  ]
}
{% endschema %}

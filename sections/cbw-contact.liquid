<div class="cbw-container cbw-contact">
  <p class="cbw-contact__eyebrow">{{ page.title | escape }}</p>

  <div class="cbw-contact__intro">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 868 | image_tag: widths: '434, 868', sizes: '434px', class: 'cbw-contact__image', alt: '' }}
    {%- else -%}
      <img class="cbw-contact__image" src="{{ 'cbw-contact-photo.jpg' | asset_url }}" alt="" width="434" height="288">
    {%- endif -%}
    <h1 class="cbw-contact__heading">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.email != blank -%}
      <p class="cbw-contact__or">{{ 'cbw.contact.or' | t }}</p>
      <p class="cbw-contact__email">
        {{ 'cbw.contact.email_to' | t }}
        <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
      </p>
    {%- endif -%}
  </div>

  {%- form 'contact', id: 'CbwContactForm', class: 'cbw-contact__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="cbw-contact__status" role="status">{{ 'templates.contact.form.post_success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="cbw-contact__status cbw-contact__status--error" role="alert" id="CbwContactErrors">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
    <div class="cbw-contact__row">
      <div class="cbw-contact__field">
        <label for="CbwContactName">{{ 'templates.contact.form.name' | t }}</label>
        <input id="CbwContactName" type="text" name="contact[{{ 'templates.contact.form.name' | t }}]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="cbw-contact__field">
        <label for="CbwContactEmail">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
        <input
          id="CbwContactEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          value="{{ form.email }}"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="CbwContactErrors"
          {% endif %}
        >
      </div>
    </div>
    <div class="cbw-contact__field">
      <label for="CbwContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
      <input id="CbwContactPhone" type="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="cbw-contact__field">
      <label for="CbwContactBody">{{ 'templates.contact.form.comment' | t }}</label>
      <textarea id="CbwContactBody" name="contact[{{ 'templates.contact.form.comment' | t }}]" rows="8">{{ form.body }}</textarea>
    </div>
    <button class="cbw-btn cbw-contact__submit" type="submit">{{ 'cbw.contact.submit' | t }}</button>
  {%- endform -%}
</div>

{% stylesheet %}
  .cbw-contact {
    padding-top: 25px;
    padding-bottom: 40px;
  }
  .cbw-contact__eyebrow {
    margin: 0 0 20px;
    font-size: 18px;
    font-weight: 700;
  }
  .cbw-contact__intro {
    text-align: center;
  }
  .cbw-contact__image {
    display: block;
    width: 434px;
    max-width: 100%;
    height: auto;
    margin: 0 auto 30px;
  }
  .cbw .cbw-contact__heading {
    margin: 0 0 30px;
    font-size: 30px;
    line-height: 1.2;
  }
  .cbw-contact__or {
    margin: 0 0 15px;
    font-size: 18px;
    font-weight: 700;
  }
  .cbw-contact__email {
    margin: 0 0 40px;
    color: var(--cbw-blue);
    font-style: italic;
    font-weight: 700;
  }
  .cbw .cbw-contact__email a {
    color: var(--cbw-blue);
    text-decoration: underline;
  }
  .cbw-contact__form {
    max-width: 700px;
    margin: 0 auto;
  }
  .cbw-contact__row {
    display: grid;
    gap: 0 20px;
  }
  .cbw-contact__field {
    margin-bottom: 15px;
  }
  .cbw-contact__field label {
    display: block;
    margin-bottom: 5px;
    font-weight: 700;
  }
  .cbw-contact__field input,
  .cbw-contact__field textarea {
    display: block;
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 0;
    font-size: 16px;
    color: var(--cbw-text);
  }
  .cbw-contact__field input {
    height: 42px;
  }
  .cbw-contact__status {
    margin: 0 0 20px;
    padding: 12px 15px;
    border: 1px solid var(--cbw-blue);
  }
  .cbw-contact__status--error {
    border-color: var(--cbw-red);
    color: var(--cbw-red);
  }
  .cbw-contact__status--error ul {
    margin: 0;
    padding-left: 20px;
  }
  @media (min-width: 768px) {
    .cbw-contact__row {
      grid-template-columns: 1fr 1fr;
    }
    .cbw .cbw-contact__heading {
      font-size: 41px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.contact.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:cbw.contact.image",
      "info": "t:cbw.contact.image_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:cbw.contact.heading",
      "default": "Please fill out the form below and click submit"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:cbw.contact.email",
      "default": "Support@CircuitBreakerWarehouse.com"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}

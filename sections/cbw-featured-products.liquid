{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="cbw-container">
  <div class="cbw-layout cbw-layout--sidebar">
    {%- render 'cbw-sidebar' -%}
    <div class="cbw-featured">
      {%- if section.settings.heading != blank -%}
        <h1 class="cbw-visually-hidden">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      <ul class="cbw-featured__grid" role="list">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            <li>
              {%- render 'cbw-product-card', product: product, align: 'left' -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            <li>
              <div class="cbw-card">
                <div class="cbw-card__image">{{ 'product-1' | placeholder_svg_tag: 'cbw-card__placeholder' }}</div>
                <p class="cbw-card__title">{{ 'cbw.product.placeholder_title' | t }}</p>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .cbw-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0 0 25px;
    list-style: none;
  }
  @media (min-width: 768px) {
    .cbw-featured__grid {
      grid-template-columns: repeat(3, minmax(0, 198px));
      justify-content: center;
    }
  }
  @media (min-width: 992px) {
    .cbw-featured__grid {
      grid-template-columns: repeat(4, minmax(0, 198px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.featured.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:cbw.featured.heading",
      "info": "t:cbw.featured.heading_info",
      "default": "Circuit Breaker Warehouse: New & Reconditioned Circuit Breakers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:cbw.featured.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:cbw.featured.products_to_show",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:cbw.featured.name"
    }
  ]
}
{% endschema %}

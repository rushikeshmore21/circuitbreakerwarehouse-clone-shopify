<div class="cbw-container cbw-page">
  <h1 class="cbw-page__title">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="cbw-page__content">{{ page.content }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cbw-page {
    padding-top: 25px;
    padding-bottom: 25px;
  }
  .cbw .cbw-page__title {
    margin: 0 0 20px;
    font-size: 30px;
    line-height: 36px;
  }
  .cbw-page__content {
    overflow-wrap: break-word;
  }
  .cbw-page__content p {
    margin: 0 0 22px;
  }
  .cbw-page__content ul,
  .cbw-page__content ol {
    margin: 0 0 22px;
    padding-left: 40px;
  }
  .cbw-page__content h2,
  .cbw-page__content h3,
  .cbw-page__content h4 {
    margin: 30px 0 22px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4286;
  }
  .cbw-page__content img {
    max-width: 100%;
    height: auto;
  }
  .cbw .cbw-page__content a {
    color: var(--cbw-red);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.page.name",
  "settings": []
}
{% endschema %}

{%- liquid
  assign index_collection = section.settings.collection | default: collections.all
-%}

<div class="cbw-container cbw-index">
  <h1 class="cbw-page__title">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="cbw-page__content">{{ page.content }}</div>
  {%- endif -%}

  {%- paginate index_collection.products by section.settings.per_page -%}
    {%- capture pager -%}
      {%- if paginate.pages > 1 -%}
        <nav class="cbw-index__pager" aria-label="{{ 'cbw.index.pages_label' | t }}">
          <span>{{ 'cbw.index.page' | t }}</span>
          {%- assign current_title = paginate.current_page | append: '' -%}
          {%- for part in paginate.parts -%}
            {%- assign part_title = part.title | append: '' -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part_title == current_title -%}
              <strong aria-current="page">{{ part.title }}</strong>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endcapture -%}

    {{ pager }}
    <table class="cbw-index__table">
      <caption class="cbw-visually-hidden">{{ page.title | escape }}</caption>
      <thead class="cbw-visually-hidden">
        <tr>
          <th scope="col">{{ 'cbw.index.code' | t }}</th>
          <th scope="col">{{ 'cbw.index.product' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for product in index_collection.products -%}
          <tr>
            <td>{{ product.selected_or_first_available_variant.sku | escape }}</td>
            <td><a href="{{ product.url }}">{{ product.title | escape }}</a></td>
          </tr>
        {%- else -%}
          <tr>
            <td colspan="2">{{ 'cbw.listing.empty_collection' | t }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    {{ pager }}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .cbw-index__pager {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 6px;
    margin: 10px 0;
  }
  .cbw .cbw-index__pager a {
    display: inline-block;
    min-width: 24px;
    min-height: 24px;
    color: var(--cbw-text);
    text-decoration: underline;
  }
  .cbw-index__table {
    border-collapse: separate;
    border-spacing: 2px;
  }
  .cbw-index__table td {
    padding: 0 2px;
    vertical-align: top;
  }
  .cbw-index__table td:first-child {
    padding-right: 30px;
    white-space: nowrap;
  }
  .cbw .cbw-index__table a {
    color: var(--cbw-red);
    text-decoration: none;
  }
  .cbw .cbw-index__table a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.index.product_name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:cbw.index.collection",
      "info": "t:cbw.index.collection_info"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:cbw.index.per_page",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 200
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}

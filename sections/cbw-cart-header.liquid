<div class="cbw-container cbw-cart-header">
  <p class="cbw-cart-header__title">{{ section.settings.title | escape }}</p>
  <a class="cbw-cart-header__shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
    {{- 'cbw.cart.shop_more' | t -}}
  </a>
  {%- if section.settings.show_guarantee -%}
    <div class="cbw-cart-header__guarantee">
      <span class="cbw-cart-header__norton">
        <img src="{{ 'cbw-buysafe-seal.png' | asset_url }}" alt="{{ 'cbw.cart.guarantee_alt' | t }}" width="100" height="54" loading="lazy">
      </span>
      <ul class="cbw-cart-header__benefits">
        <li>{%- render 'cbw-icon', name: 'shield' -%}{{ 'cbw.cart.id_theft' | t }}</li>
        <li>{%- render 'cbw-icon', name: 'check-mark' -%}{{ 'cbw.cart.purchase_guarantee' | t }}</li>
        <li>{%- render 'cbw-icon', name: 'money' -%}{{ 'cbw.cart.lowest_price' | t }}</li>
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cbw-cart-header {
    padding-top: 25px;
  }
  .cbw-cart-header__title {
    margin: 0 0 50px;
    font-size: 30px;
    line-height: 36px;
    text-align: center;
  }
  .cbw .cbw-cart-header__shop {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    background: var(--cbw-navy);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .cbw .cbw-cart-header__shop:hover {
    background: var(--cbw-red);
    color: #fff;
  }
  .cbw-cart-header__guarantee {
    display: flex;
    width: fit-content;
    flex-wrap: wrap;
    align-items: center;
    max-width: 100%;
    margin-top: 20px;
    border: 1px solid #ccc;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
  }
  .cbw-cart-header__norton {
    display: block;
    width: 94px;
    height: 28px;
    overflow: hidden;
  }
  .cbw-cart-header__norton img {
    display: block;
    width: 94px;
    height: auto;
    margin-top: -3px;
  }
  .cbw-cart-header__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    padding: 0 8px;
    list-style: none;
  }
  .cbw-cart-header__benefits li {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .cbw-cart-header__benefits .cbw-icon {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }
  .cbw .cart__empty-text {
    margin: 20px 0;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
  }
  .cbw .cart__warnings .button,
  .cbw .title-wrapper-with-link .underlined-link {
    display: none;
  }
  .cbw .title-wrapper-with-link .title--primary {
    font-size: 41px;
  }
  .cbw cart-items.is-empty .title-wrapper-with-link {
    display: flex;
  }
  .cbw .cart__login-title,
  .cbw .cart__login-paragraph {
    display: none;
  }
  .cbw .cart-items th,
  .cbw .cart-items__heading--wide,
  .cbw .caption-with-letter-spacing {
    color: var(--cbw-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .cbw .cart-items thead th {
    padding-bottom: 10px;
    border-bottom: 1px solid #ebebeb;
  }
  .cbw .cart-item__name {
    color: var(--cbw-text);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
  }
  .cbw .cart-item__name:hover {
    color: var(--cbw-red);
    text-decoration: none;
  }
  .cbw .cart-item .product-option,
  .cbw .cart-item .price {
    color: var(--cbw-text);
    font-size: 16px;
    letter-spacing: 0;
  }
  .cbw .cart-item__totals .price {
    color: var(--cbw-navy);
    font-weight: 700;
  }
  .cbw .cart-items .quantity {
    width: 120px;
    min-height: 42px;
    border-radius: 0;
  }
  .cbw .cart-items .quantity::after {
    border-radius: 0;
    box-shadow: 0 0 0 1px #ccc;
  }
  .cbw .cart-items .quantity__input {
    color: var(--cbw-text);
    font-size: 16px;
    font-weight: 700;
  }
  .cbw .cart-items .quantity__button {
    color: var(--cbw-navy);
  }
  .cbw cart-remove-button .button {
    color: var(--cbw-red);
  }
  .cbw .totals__total {
    color: var(--cbw-text);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .cbw .totals__total-value {
    color: var(--cbw-navy);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .cbw .tax-note {
    color: var(--cbw-text);
    font-size: 14px;
    letter-spacing: 0;
  }
  .cbw .cart__checkout-button {
    min-height: 42px;
    border: 1px solid var(--cbw-red);
    border-radius: 30px;
    background: var(--cbw-red);
    color: #fff;
    font-family: var(--cbw-font);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .cbw .cart__checkout-button::before,
  .cbw .cart__checkout-button::after {
    display: none;
  }
  .cbw .cart__checkout-button:hover {
    border-color: var(--cbw-navy);
    background: var(--cbw-navy);
  }
  .cbw cart-items .page-width,
  .cbw .cart__footer .page-width {
    max-width: var(--cbw-container-width);
    padding: 0 15px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.cart.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:cbw.cart.title",
      "default": "Shopping Cart"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "t:cbw.cart.shop_link"
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "t:cbw.cart.show_guarantee",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}

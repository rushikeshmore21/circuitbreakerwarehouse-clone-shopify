{%- assign today = 'now' | date: '%m/%d/%Y' -%}

{%- if section.settings.show_seal -%}
  <a
    class="cbw-floating__seal"
    href="{{ section.settings.seal_url | default: '#' }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'cbw.floating.seal_label' | t }}"
  >
    {%- if section.settings.seal_image != blank -%}
      {{ section.settings.seal_image | image_url: width: 200 | image_tag: width: 100, height: 54, alt: '', loading: 'lazy' }}
    {%- else -%}
      <img src="{{ 'cbw-buysafe-seal.png' | asset_url }}" width="100" height="54" alt="" loading="lazy">
    {%- endif -%}
    <span class="cbw-floating__seal-date">{{ today }}</span>
  </a>
{%- endif -%}

{%- if section.settings.show_message_tab and section.settings.message_text != blank -%}
  <a class="cbw-floating__message" href="{{ section.settings.message_link | default: '/pages/contact' }}">
    <span>{{ section.settings.message_text | escape }}</span>
    {%- render 'cbw-icon', name: 'email' -%}
  </a>
{%- endif -%}

{%- if section.settings.show_back_to_top -%}
  <a class="cbw-floating__top" href="#MainContent" aria-label="{{ 'cbw.floating.back_to_top' | t }}" data-cbw-top hidden>
    {%- render 'cbw-icon', name: 'arrow-up' -%}
  </a>
{%- endif -%}

{% stylesheet %}
  .cbw-floating__seal {
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 30;
    display: block;
    width: 100px;
    height: 54px;
    line-height: 0;
  }
  .cbw-floating__seal img {
    display: block;
    width: 100px;
    height: 54px;
  }
  .cbw .cbw-floating__seal-date {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background: #000;
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 0.5px;
    text-align: center;
  }
  .cbw .cbw-floating__message {
    position: fixed;
    right: 20px;
    bottom: 0;
    z-index: 30;
    display: none;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 10px;
    border: 2px solid #e5e5e5;
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
    background: #000;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  .cbw-floating__message .cbw-icon {
    width: 18px;
    height: 13px;
    fill: #fff;
  }
  .cbw .cbw-floating__top {
    position: fixed;
    right: 72px;
    bottom: 30px;
    z-index: 29;
    display: inline-flex;
    padding: 15px;
    border-radius: 50%;
    background-color: rgba(8, 3, 117, 0.5);
    transition: background-color 0.3s;
  }
  .cbw .cbw-floating__top[hidden] {
    display: none;
  }
  .cbw .cbw-floating__top:hover {
    background-color: var(--cbw-navy);
  }
  .cbw-floating__top .cbw-icon {
    width: 28px;
    height: 28px;
    fill: #fff;
  }
  @media (min-width: 768px) {
    .cbw .cbw-floating__message {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    html:focus-within {
      scroll-behavior: smooth;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const button = document.querySelector('[data-cbw-top]');
    if (!button) return;
    const toggle = () => {
      button.hidden = window.scrollY < 300;
    };
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:cbw.floating.name",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:cbw.floating.seal_header"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "t:cbw.floating.show_seal",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "seal_image",
      "label": "t:cbw.floating.seal_image"
    },
    {
      "type": "url",
      "id": "seal_url",
      "label": "t:cbw.floating.seal_url"
    },
    {
      "type": "header",
      "content": "t:cbw.floating.message_header"
    },
    {
      "type": "checkbox",
      "id": "show_message_tab",
      "label": "t:cbw.floating.show_message_tab",
      "default": true
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "t:cbw.floating.message_text",
      "default": "Leave a Message / E_MAIL: Support@CircuitBreakerWarehouse.com"
    },
    {
      "type": "url",
      "id": "message_link",
      "label": "t:cbw.floating.message_link"
    },
    {
      "type": "header",
      "content": "t:cbw.floating.top_header"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "t:cbw.floating.show_back_to_top",
      "default": true
    }
  ]
}
{% endschema %}

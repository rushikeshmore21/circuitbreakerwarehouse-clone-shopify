{%- liquid
  assign page_size = template.suffix | plus: 0
  if page_size < 1 or page_size > 250
    assign page_size = section.settings.results_per_page
  endif
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign available_sorts = search.sort_options | map: 'value'
  assign wanted_sorts = 'relevance,price-ascending,price-descending,best-selling,title-ascending,created-descending,created-ascending' | split: ','
  assign sort_values = ''
  for value in wanted_sorts
    if available_sorts contains value
      assign sort_values = sort_values | append: value | append: ','
    endif
  endfor
  assign crumb = 'cbw.search.breadcrumb' | t: terms: search.terms
-%}

<div class="cbw-container">
  <div class="cbw-layout cbw-layout--sidebar">
    {%- render 'cbw-sidebar' -%}
    <div class="cbw-listing cbw-listing--search">
      {%- if search.performed -%}
        {%- render 'cbw-breadcrumb', current: crumb -%}
      {%- else -%}
        {%- render 'cbw-breadcrumb', current: section.settings.title -%}
      {%- endif -%}
      <h1 class="cbw-visually-hidden">{{ section.settings.title | escape }}</h1>

      {%- if search.performed -%}
        {%- paginate search.results by page_size -%}
          {%- if search.results_count > 0 -%}
            {%- render 'cbw-listing-toolbar',
              paginate: paginate,
              action: routes.search_url,
              sort_by: sort_by,
              sort_values: sort_values,
              page_size: page_size,
              sizes: '50,100,200',
              default_size: 50,
              terms: search.terms
            -%}
            {%- render 'cbw-listing-grid', items: search.results -%}
            {%- render 'cbw-listing-toolbar',
              paginate: paginate,
              action: routes.search_url,
              sort_by: sort_by,
              sort_values: '',
              page_size: page_size,
              sizes: '50,100,200',
              default_size: 50,
              terms: search.terms,
              position: 'bottom'
            -%}
          {%- else -%}
            <p class="cbw-listing__empty" role="status">
              {{- 'cbw.search.no_results' | t: terms: search.terms -}}
            </p>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <p class="cbw-listing__empty">{{ 'cbw.search.prompt' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cbw-listing--search .cbw-toolbar--top {
    margin-top: 15px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.search.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:cbw.search.title",
      "default": "Search results"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:cbw.search.results_per_page",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 50
    }
  ]
}
{% endschema %}

{%- if section.settings.text != blank -%}
  <div class="cbw-top-bar">
    {%- if section.settings.link != blank -%}
      <a class="cbw-top-bar__text" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="cbw-top-bar__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .cbw-top-bar {
    padding: 8px 15px;
    text-align: center;
    background: #fff;
  }
  .cbw .cbw-top-bar__text {
    margin: 0;
    color: var(--cbw-text);
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:cbw.top_bar.name",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:cbw.top_bar.text",
      "default": "16K+ New, Refurbished & Hard-to-Find Breaker Part Numbers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:cbw.top_bar.link"
    }
  ],
  "presets": [
    {
      "name": "t:cbw.top_bar.name"
    }
  ]
}
{% endschema %}

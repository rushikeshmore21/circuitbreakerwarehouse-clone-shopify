{%- if section.blocks.size > 0 -%}
  <div class="cbw-brands">
    <div class="cbw-container">
      <div class="cbw-brands__inner">
        <button
          class="cbw-brands__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="CbwBrands-{{ section.id }}"
          data-cbw-brands-toggle
        >
          <span>{{ section.settings.toggle_label | escape }}</span>
          {%- render 'cbw-icon', name: 'plus', class: 'cbw-brands__toggle-icon' -%}
        </button>
        <ul class="cbw-brands__list" id="CbwBrands-{{ section.id }}" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              case block.settings.logo
                when 'ge'
                  assign fallback = 'cbw-brand-ge.png'
                  assign fallback_w = 89
                  assign fallback_h = 89
                when 'siemens'
                  assign fallback = 'cbw-brand-siemens.png'
                  assign fallback_w = 224
                  assign fallback_h = 42
                when 'zinsco'
                  assign fallback = 'cbw-brand-zinsco.png'
                  assign fallback_w = 136
                  assign fallback_h = 69
                when 'fpe'
                  assign fallback = 'cbw-brand-fpe.png'
                  assign fallback_w = 184
                  assign fallback_h = 72
                when 'cutler-hammer'
                  assign fallback = 'cbw-brand-cutler-hammer.png'
                  assign fallback_w = 193
                  assign fallback_h = 104
                when 'ite'
                  assign fallback = 'cbw-brand-ite.png'
                  assign fallback_w = 173
                  assign fallback_h = 114
                when 'westinghouse'
                  assign fallback = 'cbw-brand-westinghouse.png'
                  assign fallback_w = 212
                  assign fallback_h = 68
                when 'eaton'
                  assign fallback = 'cbw-brand-eaton.png'
                  assign fallback_w = 157
                  assign fallback_h = 59
                else
                  assign fallback = blank
              endcase
            -%}
            <li class="cbw-brands__item" {{ block.shopify_attributes }}>
              <a class="cbw-brands__link" href="{{ block.settings.link | default: '#' }}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 448 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'cbw-brands__logo' }}
                {%- elsif fallback != blank -%}
                  <img class="cbw-brands__logo" src="{{ fallback | asset_url }}" alt="{{ block.settings.name | escape }}" width="{{ fallback_w }}" height="{{ fallback_h }}" loading="lazy">
                {%- endif -%}
                <span class="cbw-brands__name">{{ block.settings.name | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .cbw-brands {
    margin-top: 20px;
  }
  .cbw-brands__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 55px;
    padding: 0 15px;
    border: 0;
    background: var(--cbw-red);
    color: #fff;
    font-family: var(--cbw-font);
    font-size: 21px;
    font-weight: 600;
    cursor: pointer;
  }
  .cbw-brands__toggle-icon {
    width: 15px;
    height: 15px;
    fill: #fff;
  }
  .cbw-brands__toggle-icon .vert {
    transform-origin: center;
    transition: transform 0.2s ease-in-out;
  }
  .cbw-brands__toggle[aria-expanded='true'] .cbw-brands__toggle-icon .vert {
    transform: scaleY(0);
  }
  .cbw-brands__list {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--cbw-red);
    font-size: 21px;
    font-weight: 600;
  }
  .cbw-brands__toggle[aria-expanded='true'] + .cbw-brands__list {
    display: block;
  }
  .cbw-brands__item {
    padding-left: 15px;
    line-height: 57px;
    border-top: 1px solid #ebebeb;
  }
  .cbw-brands__item:first-child {
    border-top: 0;
  }
  .cbw .cbw-brands__link {
    color: inherit;
    text-decoration: none;
  }
  .cbw-brands__logo {
    display: none;
  }

  @media (min-width: 768px) {
    .cbw-brands {
      margin: 40px 0 45px;
    }
    .cbw-brands__toggle {
      display: none;
    }
    .cbw-brands__list,
    .cbw-brands__toggle[aria-expanded='true'] + .cbw-brands__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .cbw-brands__item {
      height: 129px;
      padding: 0;
      border-left: 1px solid #ebebeb;
      line-height: normal;
    }
    .cbw-brands__item:nth-child(2) {
      border-top: 0;
    }
    .cbw-brands__item:nth-child(odd) {
      border-left: 0;
    }
    .cbw-brands__link {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
    }
    .cbw-brands__logo {
      display: block;
      max-width: 100%;
      height: auto;
    }
    .cbw-brands__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }
  @media (min-width: 992px) {
    .cbw-brands__inner {
      margin-left: 25%;
    }
    .cbw-brands__list,
    .cbw-brands__toggle[aria-expanded='true'] + .cbw-brands__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .cbw-brands__item,
    .cbw-brands__item:nth-child(odd) {
      border-left: 1px solid #ebebeb;
    }
    .cbw-brands__item:nth-child(-n + 3) {
      border-top: 0;
    }
    .cbw-brands__item:nth-child(3n + 1) {
      border-left: 0;
    }
    .cbw-brands__link {
      filter: grayscale(100%);
      opacity: 0.6;
      transition: 0.2s ease-in-out;
    }
    .cbw-brands__link:hover,
    .cbw-brands__link:focus-visible {
      filter: grayscale(0);
      opacity: 1;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const toggle = event.target.closest('[data-cbw-brands-toggle]');
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', toggle.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:cbw.brands.name",
  "settings": [
    {
      "type": "text",
      "id": "toggle_label",
      "label": "t:cbw.brands.toggle_label",
      "default": "Shop Popular Brands"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:cbw.brands.brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:cbw.brands.brand_name",
          "default": "GE"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:cbw.brands.image"
        },
        {
          "type": "select",
          "id": "logo",
          "label": "t:cbw.brands.bundled_logo",
          "info": "t:cbw.brands.bundled_logo_info",
          "default": "none",
          "options": [
            { "value": "none", "label": "t:cbw.brands.logo_none" },
            { "value": "ge", "label": "GE" },
            { "value": "siemens", "label": "Siemens" },
            { "value": "zinsco", "label": "Zinsco" },
            { "value": "fpe", "label": "Federal Pacific" },
            { "value": "cutler-hammer", "label": "Cutler Hammer" },
            { "value": "ite", "label": "ITE" },
            { "value": "westinghouse", "label": "Westinghouse" },
            { "value": "eaton", "label": "Eaton" }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:cbw.brands.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:cbw.brands.name"
    }
  ]
}
{% endschema %}

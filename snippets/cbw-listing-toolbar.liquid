{% doc %}
  Renders the listing toolbar from the live site: "Sort By" select + GO, per-page select,
  "Page [n] of N" jump box and NEXT/PREV buttons. Works without JavaScript (GET forms);
  JavaScript only auto-submits when the per-page select changes.

  Per-page choices use alternate templates (?view=64 etc.), because Liquid can't read
  arbitrary query parameters. Page sizes are capped at 250 by Shopify.

  @param {object} paginate - The paginate object from the surrounding paginate tag
  @param {string} action - Form action URL (collection URL or search URL)
  @param {string} sort_by - The active sort value
  @param {string} sort_values - Comma-separated sort values to offer, in display order
  @param {number} page_size - The active page size
  @param {string} [sizes] - Comma-separated per-page choices. Defaults to '32,64,128,192'
  @param {number} [default_size] - The page size of the default template (no ?view). Defaults to 32
  @param {string} [terms] - Search terms to keep (search page only)
  @param {string} [position] - 'top' (full toolbar) or 'bottom' (NEXT/PREV only). Defaults to 'top'

  @example
  {% render 'cbw-listing-toolbar', paginate: paginate, action: collection.url, sort_by: sort_by, sort_values: 'price-ascending,price-descending', page_size: 32 %}
{% enddoc %}

{%- liquid
  assign sorts = sort_values | split: ','
  assign size_list = sizes | default: '32,64,128,192' | split: ','
  assign base_size = default_size | default: 32
  assign view = ''
  if page_size != base_size
    assign view = page_size
  endif
  assign uid = position | default: 'top'
  assign page_count = paginate.pages | at_least: 1
-%}

<div class="cbw-toolbar cbw-toolbar--{{ uid }}">
  {%- if uid == 'top' -%}
    <form class="cbw-toolbar__sort" action="{{ action }}" method="get" data-cbw-toolbar-form>
      {%- if terms != blank -%}
        <input type="hidden" name="q" value="{{ terms | escape }}">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
      {%- endif -%}
      <label class="cbw-toolbar__label" for="CbwSortBy">{{ 'cbw.listing.sort_by' | t }}</label>
      <select class="cbw-toolbar__select" id="CbwSortBy" name="sort_by">
        {%- for value in sorts -%}
          {%- assign label_key = 'cbw.sort.' | append: value | replace: '-', '_' -%}
          <option value="{{ value }}" {% if value == sort_by %}selected{% endif %}>{{ label_key | t }}</option>
        {%- endfor -%}
      </select>
      <button class="cbw-toolbar__go" type="submit">{{ 'cbw.listing.go' | t }}</button>
      <label class="cbw-visually-hidden" for="CbwPerPage">{{ 'cbw.listing.per_page_label' | t }}</label>
      <select class="cbw-toolbar__select cbw-toolbar__per-page" id="CbwPerPage" name="view" data-cbw-autosubmit>
        {%- for size in size_list -%}
          {%- assign size_number = size | plus: 0 -%}
          <option value="{% if size_number != base_size %}{{ size }}{% endif %}" {% if size_number == page_size %}selected{% endif %}>
            {{- 'cbw.listing.per_page' | t: count: size -}}
          </option>
        {%- endfor -%}
      </select>
    </form>

    <form class="cbw-toolbar__jump" action="{{ action }}" method="get">
      {%- if terms != blank -%}
        <input type="hidden" name="q" value="{{ terms | escape }}">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
      {%- endif -%}
      {%- if sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ sort_by }}">
      {%- endif -%}
      {%- if view != '' -%}
        <input type="hidden" name="view" value="{{ view }}">
      {%- endif -%}
      <label class="cbw-toolbar__page-label" for="CbwPageJump">{{ 'cbw.listing.page' | t }}</label>
      <input
        class="cbw-toolbar__page-input"
        id="CbwPageJump"
        type="number"
        name="page"
        min="1"
        max="{{ page_count }}"
        value="{{ paginate.current_page }}"
        inputmode="numeric"
      >
      <span class="cbw-toolbar__page-of">{{ 'cbw.listing.of_pages' | t: pages: page_count }}</span>
      <button class="cbw-visually-hidden" type="submit">{{ 'cbw.listing.go_to_page' | t }}</button>
    </form>
  {%- endif -%}

  <div class="cbw-toolbar__pager">
    {%- if paginate.previous -%}
      <a class="cbw-toolbar__nav" href="{{ paginate.previous.url }}">{{ 'cbw.listing.prev' | t }}</a>
    {%- endif -%}
    {%- if paginate.next -%}
      <a class="cbw-toolbar__nav" href="{{ paginate.next.url }}">{{ 'cbw.listing.next' | t }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cbw-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 15px;
    margin: 0 0 22px;
  }
  .cbw-toolbar--bottom {
    justify-content: flex-end;
    margin: 10px 0 0;
  }
  .cbw-toolbar__sort,
  .cbw-toolbar__jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 3px;
  }
  .cbw-toolbar__label {
    margin-right: 2px;
    font-weight: 700;
  }
  .cbw-toolbar__select {
    height: 42px;
    padding: 0 16px;
    border: 1px solid #ccc;
    border-radius: 0;
    background-color: #fff;
    color: var(--cbw-text);
    font-size: 16px;
    font-weight: 500;
  }
  #CbwSortBy {
    width: 179px;
  }
  .cbw-toolbar__per-page {
    width: 148px;
  }
  .cbw-toolbar__go,
  .cbw .cbw-toolbar__nav {
    display: inline-block;
    min-width: 64px;
    padding: 12px 16px;
    border: 0;
    background: var(--cbw-navy);
    color: #fff;
    font-family: var(--cbw-font);
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  .cbw-toolbar__go {
    margin-left: 8px;
  }
  .cbw-toolbar__go:hover,
  .cbw .cbw-toolbar__nav:hover {
    background: var(--cbw-red);
    color: #fff;
  }
  .cbw-toolbar__page-label,
  .cbw-toolbar__page-of {
    font-size: 13px;
    font-weight: 700;
  }
  .cbw-toolbar__page-input {
    width: 68px;
    height: 42px;
    padding: 0 16px;
    border: 1px solid #ccc;
    border-radius: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--cbw-text);
    -moz-appearance: textfield;
  }
  .cbw-toolbar__page-input::-webkit-inner-spin-button,
  .cbw-toolbar__page-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cbw-toolbar__pager {
    display: flex;
    gap: 8px;
  }
  @media (min-width: 768px) {
    .cbw-toolbar--top .cbw-toolbar__sort {
      flex: 1 1 auto;
    }
    .cbw-toolbar--top .cbw-toolbar__per-page {
      margin-left: auto;
      margin-right: 6px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('change', (event) => {
    const select = event.target.closest('[data-cbw-autosubmit]');
    if (select) select.form.requestSubmit();
  });
{% endjavascript %}

{% doc %}
  Renders the live-site breadcrumb: "{shop}> Home > {current}" plus BreadcrumbList JSON-LD.

  @param {string} current - Title of the current page
  @param {string} [parent_title] - Optional middle crumb title (e.g. the product's collection)
  @param {string} [parent_url] - URL for the middle crumb
  @param {boolean} [show_shop] - Show the shop name before "Home". Defaults to true

  @example
  {% render 'cbw-breadcrumb', current: collection.title %}
{% enddoc %}

<nav class="cbw-breadcrumb" aria-label="{{ 'cbw.breadcrumb.label' | t }}">
  <ol class="cbw-breadcrumb__list">
    {%- unless show_shop == false -%}
      <li class="cbw-breadcrumb__shop">{{ shop.name | escape }}&gt;</li>
    {%- endunless -%}
    <li><a href="{{ routes.root_url }}">{{ 'cbw.breadcrumb.home' | t }}</a></li>
    {%- if parent_title != blank -%}
      <li><a href="{{ parent_url }}">{{ parent_title | escape_once }}</a></li>
    {%- endif -%}
    {%- if current != blank -%}
      <li><span class="cbw-breadcrumb__current" aria-current="page">{{ current | escape_once }}</span></li>
    {%- endif -%}
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'cbw.breadcrumb.home' | t | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      }
      {%- if parent_title != blank -%}
        ,
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ parent_title | json }},
          "item": {{ request.origin | append: parent_url | json }}
        }
      {%- endif -%}
      {%- if current != blank -%}
        ,
        {
          "@type": "ListItem",
          "position": {% if parent_title != blank %}3{% else %}2{% endif %},
          "name": {{ current | json }}
        }
      {%- endif %}
    ]
  }
</script>

{% stylesheet %}
  .cbw-breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 20px;
  }
  .cbw-breadcrumb__list li + li::before {
    content: '>';
    padding: 0 4px;
  }
  .cbw-breadcrumb__list .cbw-breadcrumb__shop + li::before {
    content: none;
  }
  .cbw-breadcrumb__shop {
    padding-right: 4px;
  }
  .cbw .cbw-breadcrumb a {
    color: var(--cbw-text);
    text-decoration: none;
  }
  .cbw .cbw-breadcrumb a:hover {
    color: var(--cbw-red);
  }
  .cbw-breadcrumb__current {
    color: #666;
  }
{% endstylesheet %}
